generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerType {
  WHOLESALE
  RETAIL
  UNKNOWN
}

enum ConversationStatus {
  ACTIVE
  CLOSED
}

enum MessageDirection {
  IN
  OUT
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model Customer {
  id                     String   @id @default(cuid())
  waPhoneNumber          String
  // The WhatsApp phone_number_id of the *business* number the customer
  // messaged. Scopes customer identity per business so the same WhatsApp
  // number talking to two different connected businesses gets two separate
  // customer records.
  businessPhoneNumberId  String
  name                   String?
  customerType           CustomerType @default(UNKNOWN)
  preferredLanguage      String?
  isNew                  Boolean  @default(true)
  firstMessageText       String?
  firstSeenAt            DateTime @default(now())
  lastSeenAt             DateTime @default(now())
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  conversations Conversation[]
  messages      Message[]

  @@unique([waPhoneNumber, businessPhoneNumberId])
  @@index([businessPhoneNumberId])
}

model Conversation {
  id                  String             @id @default(cuid())
  customerId          String
  customer            Customer           @relation(fields: [customerId], references: [id])
  status              ConversationStatus @default(ACTIVE)
  windowExpiresAt     DateTime?
  activeFlow          String?
  flowState           Json?
  // Set when the AI defers to a human (low confidence, unsupported media,
  // or an LLM failure) — a lightweight triage flag for staff to review.
  needsHumanAttention Boolean            @default(false)
  escalatedAt         DateTime?
  startedAt           DateTime           @default(now())
  endedAt             DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  messages Message[]

  @@index([customerId, status])
  @@index([customerId, createdAt])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id])
  customerId     String
  customer       Customer          @relation(fields: [customerId], references: [id])
  waMessageId    String?           @unique
  direction      MessageDirection
  content        String
  mediaType      String?
  mediaMimeType  String?
  toolCalls      Json?
  tokensUsed     Json?
  status         MessageStatus?
  isAutomated    Boolean           @default(false)
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
}
