# --- Core ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
BUSINESS_TIMEZONE=Asia/Kolkata

# --- Database & Queue ---
DATABASE_URL=postgresql://brunda:brunda_dev_password@localhost:5432/brunda_traders
REDIS_URL=redis://localhost:6379

# --- OpenRouter (LLM gateway) ---
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key
# provider/model-name — see https://openrouter.ai/models for current slugs
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# --- Meta WhatsApp Business Cloud API (direct, no BSP) ---
# Use a System User permanent access token in production — see README.md
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
# App secret, used to verify X-Hub-Signature-256 on inbound webhooks
WHATSAPP_APP_SECRET=your_whatsapp_app_secret
# Arbitrary string you choose and enter in Meta's webhook config (GET verification handshake)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me-to-a-random-string

# When true, the Outbound Sender logs the WhatsApp API call it *would* make
# instead of actually calling the Graph API. Use this until real WhatsApp
# credentials exist. Set to false once WHATSAPP_ACCESS_TOKEN /
# WHATSAPP_PHONE_NUMBER_ID are real.
WHATSAPP_DRY_RUN=true

# --- Conversation behavior ---
# Exact number of prior messages sent to the model for context (per plan: 15)
CONTEXT_MESSAGE_LIMIT=15
# Relative to the repository root
SYSTEM_PROMPT_PATH=config/system-prompt.txt
